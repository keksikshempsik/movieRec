<Window x:Class="MovieRecV5.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="MovieRec" 
        Height="720" 
        Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#0F0F0F"
        FontFamily="Segoe UI"
        AllowsTransparency="False"
        WindowStyle="SingleBorderWindow">

    <!-- Ресурсы для стилей -->
    <Window.Resources>
        <!-- Цвета -->
        <SolidColorBrush x:Key="PrimaryColor" Color="#6C5CE7"/>
        <SolidColorBrush x:Key="PrimaryDarkColor" Color="#5849C4"/>
        <SolidColorBrush x:Key="AccentColor" Color="#00B894"/>
        <SolidColorBrush x:Key="BackgroundColor" Color="#0F0F0F"/>
        <SolidColorBrush x:Key="SurfaceColor" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#B0B0B0"/>
        <SolidColorBrush x:Key="BorderColor" Color="#2D2D2D"/>

        <!-- Стиль для кнопок -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource PrimaryDarkColor}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для текстового поля -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="White"/>
            <!-- Белый текст -->
            <Setter Property="BorderBrush" Value="#404040"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                      Margin="5,0"
                                      Background="Transparent"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#6C5CE7"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#6C5CE7"/>
                                <Setter Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для карточки фильма -->
        <Style x:Key="MovieCardStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="12">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Анимации -->
        <Storyboard x:Key="FadeInAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                           From="0" To="1" Duration="0:0:0.3"/>
        </Storyboard>
    </Window.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceColor}"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="0,0,0,1"
                Padding="20,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Логотип -->
                <StackPanel Grid.Column="0" 
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="🎬" 
                               FontSize="32" 
                               Margin="0,0,10,0"/>
                    <TextBlock Text="MovieRec" 
                               FontSize="24" 
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimary}">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#6C5CE7" BlurRadius="20" Opacity="0.5"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </StackPanel>

                <!-- Поисковая строка -->
                <Border Grid.Column="1"
        Background="#1E1E1E"
        BorderBrush="#6C5CE7"
        BorderThickness="1"
        CornerRadius="25"
        Height="45"
        Width="500"
        Margin="20,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Поле ввода -->
                        <Grid Grid.Column="0">
                            <TextBox x:Name="SearchTextBox" 
                     Background="#2D2D2D"
                     Foreground="White"
                     BorderThickness="0"
                     Padding="15,0"
                     VerticalAlignment="Center"
                     FontSize="14"
                     FontFamily="Segoe UI"
                     CaretBrush="White"
                     KeyDown="SearchTextBox_KeyDown"
                     TextChanged="SearchTextBox_TextChanged"
                     GotFocus="SearchTextBox_GotFocus"
                     LostFocus="SearchTextBox_LostFocus"/>

                            <!-- Плейсхолдер -->
                            <TextBlock x:Name="SearchPlaceholder"
                       Text="Введите название фильма..."
                       Foreground="#808080"
                       IsHitTestVisible="False"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left"
                       Margin="15,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ElementName=SearchTextBox, Path=Text.Length}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <Button Grid.Column="1"
                Name="SearchButton"
                Content="🔍"
                Background="#6C5CE7"
                Foreground="White"
                FontSize="18"
                BorderThickness="0"
                Width="45"
                Height="45"
                Click="SearchButton_Click"
                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="0,25,25,0">
                                        <ContentPresenter HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- Правая панель -->
                <StackPanel Grid.Column="2" 
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    
                    <Button Name="FiltersButton" 
                            Style="{StaticResource ModernButton}"
                            Content="🔍 Фильтры"
                            Click="FiltersButton_Click"
                            Width="110"
                            Height="40"
                            Margin="0,0,10,0"
                            Background="#404040"/>

                    <!-- Прогресс бар -->
                    <ProgressBar Name="SearchProgressBar" 
                                 Width="100"
                                 Height="4"
                                 Margin="0,0,20,0"
                                 Background="{StaticResource SurfaceColor}"
                                 Foreground="{StaticResource PrimaryColor}"
                                 BorderThickness="0"
                                 Visibility="Collapsed"
                                 IsIndeterminate="False"/>

                    <!-- После прогресс-бара -->
                    <TextBlock Name="FiltersActiveIndicator" 
                                Text="🔴"
                                FontSize="12"
                                Foreground="#6C5CE7"
                                Margin="0,0,10,0"
                                Visibility="Collapsed"
                                ToolTip="Применены фильтры"
                                VerticalAlignment="Center"/>

                    <!-- Кнопка рекомендаций -->
                    <Button Name="RecommendationsButton" 
                            Style="{StaticResource ModernButton}"
                            Content="🎯 Рекомендации"
                            Click="RecommendationsButton_Click"
                            Width="130"
                            Height="40"
                            Margin="0,0,10,0"/>

                    <!-- Кнопка профиля -->
                    <Button Name="UserProfileButton" 
                            Style="{StaticResource ModernButton}"
                            Content="👤 Войти"
                            Click="UserProfileButton_Click"
                            Width="120"
                            Height="40"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Основная область с фильмами -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Background="{StaticResource BackgroundColor}">
            <WrapPanel x:Name="MoviesPanel" 
                      HorizontalAlignment="Center"
                      Margin="20"/>
        </ScrollViewer>
    </Grid>
</Window>