<Window x:Class="MovieRecV5.ViewModels.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход / Регистрация" 
        Height="468" 
        Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0F0F0F"
        Foreground="White"
        FontFamily="Segoe UI"
        WindowStyle="SingleBorderWindow">

    <Border Background="#1E1E1E" CornerRadius="20" Margin="15">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="25">
                <!-- Заголовок -->
                <Border Background="{StaticResource HeaderGradient}"
                        CornerRadius="15"
                        Padding="20"
                        Margin="0,0,0,20">
                    <TextBlock Text="🎬 MovieRec" 
                               FontSize="24" 
                               FontWeight="Bold" 
                               HorizontalAlignment="Center"
                               Foreground="White"/>
                </Border>

                <!-- Переключатели -->
                <StackPanel Orientation="Horizontal" 
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20">
                    <RadioButton x:Name="rbLogin" 
                               Content="Вход" 
                               IsChecked="True" 
                               GroupName="AuthMode" 
                               Style="{StaticResource ModernRadioButton}"
                               Margin="0,0,20,0"/>
                    <RadioButton x:Name="rbRegister" 
                               Content="Регистрация" 
                               GroupName="AuthMode" 
                               Style="{StaticResource ModernRadioButton}"/>
                </StackPanel>

                <!-- Форма -->
                <StackPanel>
                    <TextBlock Text="Логин" 
                               Foreground="#B0B0B0"
                               Margin="0,0,0,5"/>
                    <TextBox x:Name="txtLogin" 
                            Style="{StaticResource ModernTextBox}"
                            Margin="0,0,0,15"/>

                    <TextBlock Text="Пароль" 
                               Foreground="#B0B0B0"
                               Margin="0,0,0,5"/>
                    <PasswordBox x:Name="txtPassword" 
                                Style="{StaticResource ModernPasswordBox}"
                                Margin="0,0,0,15"/>

                    <!-- Дополнительные поля для регистрации -->
                    <StackPanel x:Name="pnlRegister" Visibility="Collapsed">
                        <TextBlock Text="Отображаемое имя" 
                                   Foreground="#B0B0B0"
                                   Margin="0,0,0,5"/>
                        <TextBox x:Name="txtDisplayName" 
                                Style="{StaticResource ModernTextBox}"
                                Margin="0,0,0,15"/>

                        <TextBlock Text="Email" 
                                   Foreground="#B0B0B0"
                                   Margin="0,0,0,5"/>
                        <TextBox x:Name="txtEmail" 
                                Style="{StaticResource ModernTextBox}"
                                Margin="0,0,0,15"/>
                    </StackPanel>

                    <!-- Галочка "Запомнить меня" -->
                    <CheckBox x:Name="chkRememberMe" 
                             Content="Запомнить меня" 
                             Style="{StaticResource ModernCheckBox}"
                             IsChecked="True"
                             IsEnabled="{Binding ElementName=rbLogin, Path=IsChecked}"
                             Margin="0,0,0,20"/>

                    <!-- Кнопка -->
                    <Button x:Name="btnSubmit" 
                           Content="Войти" 
                           Style="{StaticResource ActionButton}"
                           Click="BtnSubmit_Click"
                           Margin="0,0,0,10"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>