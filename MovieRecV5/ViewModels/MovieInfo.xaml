<Page x:Class="MovieRecV5.ViewModels.MovieInfo"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Информация о фильме"
      Height="700" Width="900">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок и кнопка назад (фиксированный) -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10,10,10,5">
            <Button x:Name="BackButton" 
                    Content="Назад" 
                    Click="BackButton_Click"
                    Width="80"
                    Height="25"/>

            <TextBlock Text="Информация о фильме" 
                       FontSize="16" 
                       FontWeight="Bold" 
                       VerticalAlignment="Center"
                       Margin="10,0,0,0"/>
        </StackPanel>

        <!-- Прокручиваемая область -->
        <ScrollViewer Grid.Row="1" 
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Margin="10,0,10,10">

            <StackPanel>
                <!-- Основная информация -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Постер -->
                    <Image x:Name="MoviePoster" 
                           Grid.Column="0"
                           Width="150" 
                           Height="200"
                           Margin="0,0,10,0"/>

                    <!-- Информация справа -->
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="MovieTitle" 
                                   FontSize="14" 
                                   FontWeight="Bold" 
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,5"/>

                        <TextBlock x:Name="MovieYear" 
                                   FontSize="12" 
                                   Margin="0,0,0,5"/>

                        <!-- РЕЙТИНГ -->
                        <TextBlock x:Name="MovieRating"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#FFD700"
                                   Margin="0,0,0,5"
                                   Text="Рейтинг: Загрузка..."/>

                        <!-- КОЛИЧЕСТВО ПРОСМОТРОВ -->
                        <TextBlock x:Name="MovieVoteCount"
                                   FontSize="12"
                                   Foreground="Gray"
                                   Margin="0,0,0,10"
                                   Text="Загрузка..."/>

                        <TextBlock Text="Жанры:" 
                                   FontWeight="Bold" 
                                   Margin="0,0,0,5"/>

                        <ItemsControl x:Name="GenresList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" 
                                               Margin="0,0,5,0"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>

                <!-- Кнопки действий (просмотр, watchlist и избранное) -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Кнопка отметки просмотра -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button x:Name="WatchedButton"
                Content="Отметить как просмотренный"
                Click="WatchedButton_Click"
                Width="180"
                Height="25"
                Background="LightGreen"/>

                        <TextBlock x:Name="WatchedStatusText"
                   Text=""
                   FontSize="12"
                   VerticalAlignment="Center"
                   Margin="10,0,0,0"
                   Foreground="Green"/>
                    </StackPanel>

                    <!-- Кнопка добавления в WatchList -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="WatchListButton"
                Content="Хочу посмотреть"
                Click="WatchListButton_Click"
                Width="150"
                Height="25"
                Background="LightYellow"
                Margin="10,0,0,0"/>

                        <TextBlock x:Name="WatchListStatusText"
                   Text=""
                   FontSize="12"
                   VerticalAlignment="Center"
                   Margin="10,0,0,0"
                   Foreground="Orange"/>
                    </StackPanel>

                    <!-- КНОПКА ИЗБРАННОГО        -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button x:Name="FavoriteButton"
                Content="❤️ В избранное"
                Click="FavoriteButton_Click"
                Width="120"
                Height="25"
                Background="LightPink"
                Margin="10,0,0,0"/>

                        <TextBlock x:Name="FavoriteStatusText"
                   Text=""
                   FontSize="12"
                   VerticalAlignment="Center"
                   Margin="10,0,0,0"
                   Foreground="Red"/>
                    </StackPanel>
                </Grid>

                <!-- Система оценки -->
                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="Ваша оценка:" 
                               FontWeight="Bold" 
                               Margin="0,0,0,5"/>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Звезды для оценки -->
                        <ItemsControl x:Name="RatingStars" Loaded="RatingStars_Loaded">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="★"
                                            FontSize="20"
                                            Foreground="LightGray"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Margin="2,0"
                                            Cursor="Hand"
                                            Tag="{Binding}"
                                            Click="StarButton_Click"
                                            MouseEnter="StarButton_MouseEnter"
                                            MouseLeave="StarButton_MouseLeave"
                                            Loaded="StarButton_Loaded"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="SelectedRatingText"
                                   Text="0/10"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0"
                                   Foreground="Gray"/>
                    </StackPanel>

                    <Button x:Name="SubmitRatingButton"
                            Content="Подтвердить оценку"
                            Click="SubmitRatingButton_Click"
                            Width="120"
                            Height="25"
                            Margin="0,5,0,0"
                            IsEnabled="False"/>
                </StackPanel>

                <!-- Описание -->
                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="Описание:" 
                               FontWeight="Bold" 
                               Margin="0,0,0,5"/>

                    <TextBox x:Name="MovieDescription" 
                             TextWrapping="Wrap" 
                             FontSize="12"
                             Height="120"
                             IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto"/>
                </StackPanel>

                <!-- ===== СЕКЦИЯ: ОТЗЫВЫ ===== -->
                <StackPanel>
                    <!-- Заголовок секции отзывов -->
                    <Border Background="#F0F0F0" 
                            BorderBrush="#D0D0D0"
                            BorderThickness="1"
                            Margin="0,5,0,5">
                        <TextBlock Text="📝 Отзывы пользователей" 
                                   FontWeight="Bold" 
                                   FontSize="14"
                                   Margin="5"/>
                    </Border>

                    <!-- Панель для написания отзыва (только для авторизованных) -->
                    <Border x:Name="ReviewEditPanel" 
                            Background="#F9F9F9"
                            BorderBrush="LightGray"
                            BorderThickness="1"
                            Margin="0,5,0,10">
                        <StackPanel Margin="5">
                            <!-- Приглашение для неавторизованных -->
                            <TextBlock x:Name="ReviewLoginPrompt" 
                                       Text="Войдите в систему, чтобы оставить отзыв"
                                       Foreground="Gray"
                                       Visibility="Collapsed"
                                       Margin="5"/>

                            <!-- Поле ввода отзыва -->
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBox x:Name="ReviewTextBox"
                                         Grid.Row="0"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         Height="80"
                                         MaxLength="1000"
                                         VerticalScrollBarVisibility="Auto"
                                         Margin="0,0,0,5"/>

                                <!-- Кнопки управления отзывом -->
                                <StackPanel Grid.Row="1" 
                                            Orientation="Horizontal" 
                                            HorizontalAlignment="Right"
                                            Margin="0,5,0,0">

                                    <TextBlock x:Name="ReviewCharCount"
                                               Text="0/1000"
                                               FontSize="10"
                                               Foreground="Gray"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"/>

                                    <Button x:Name="DeleteReviewButton"
                                            Content="Удалить"
                                            Click="DeleteReviewButton_Click"
                                            Width="80"
                                            Height="25"
                                            Background="LightCoral"
                                            Foreground="White"
                                            Margin="0,0,5,0"
                                            Visibility="Collapsed"/>

                                    <Button x:Name="CancelEditReviewButton"
                                            Content="Отмена"
                                            Click="CancelEditReviewButton_Click"
                                            Width="80"
                                            Height="25"
                                            Margin="0,0,5,0"
                                            Visibility="Collapsed"/>

                                    <Button x:Name="SaveReviewButton"
                                            Content="Опубликовать отзыв"
                                            Click="SaveReviewButton_Click"
                                            Width="120"
                                            Height="25"
                                            Background="#4CAF50"
                                            Foreground="White"
                                            IsEnabled="False"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Список отзывов -->
                    <StackPanel x:Name="ReviewsListPanel" Margin="0,0,0,5"/>

                    <!-- Сообщение, если нет отзывов -->
                    <TextBlock x:Name="NoReviewsText"
                               Text="Пока нет отзывов. Будьте первым!"
                               Foreground="Gray"
                               HorizontalAlignment="Center"
                               Margin="0,10"
                               Visibility="Collapsed"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>