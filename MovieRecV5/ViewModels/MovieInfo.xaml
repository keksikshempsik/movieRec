<Page x:Class="MovieRecV5.ViewModels.MovieInfo"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Информация о фильме"
      Background="#0F0F0F"
      Foreground="White"
      FontFamily="Segoe UI"
      Height="800" Width="1000">

    <Page.Resources>
        <!-- Градиенты -->
        <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#6C5CE7" Offset="0"/>
            <GradientStop Color="#00B894" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="CardGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#2D2D2D" Offset="0"/>
            <GradientStop Color="#1E1E1E" Offset="1"/>
        </LinearGradientBrush>

        <!-- Стиль для кнопок -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="20"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для звезд рейтинга -->
        <Style x:Key="StarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="Foreground" Value="#FFD700"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для текстового поля -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20">

            <!-- Кнопка назад -->
            <Button x:Name="BackButton"
                    Style="{StaticResource ActionButton}"
                    Content="← Назад"
                    Click="BackButton_Click"
                    Width="80"
                    HorizontalAlignment="Left"
                    Margin="0,0,0,20"/>

            <!-- Основная карточка фильма -->
            <Border Background="{StaticResource CardGradient}"
                    CornerRadius="20"
                    Padding="25"
                    Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Постер -->
                    <Border Grid.Column="0"
                            CornerRadius="15"
                            Background="#2D2D2D"
                            Height="350">
                        <Image x:Name="MoviePoster" 
                               Stretch="Uniform"
                               Margin="5"/>
                    </Border>

                    <!-- Информация -->
                    <StackPanel Grid.Column="1"
                                Margin="20,0,0,0"
                                VerticalAlignment="Top">

                        <TextBlock x:Name="MovieTitle" 
                                   FontSize="28" 
                                   FontWeight="Bold"
                                   Foreground="White"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10"/>

                        <TextBlock x:Name="MovieYear" 
                                   FontSize="16"
                                   Foreground="#B0B0B0"
                                   Margin="0,0,0,15"/>

                        <!-- Рейтинг -->
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Background="#FFD700"
                                    CornerRadius="5"
                                    Padding="8,3"
                                    Margin="0,0,10,0">
                                <TextBlock x:Name="MovieRating"
                                           Text="7.5"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="Black"/>
                            </Border>

                            <TextBlock Grid.Column="1"
                                       x:Name="MovieVoteCount"
                                       Text="150K votes"
                                       FontSize="14"
                                       Foreground="#B0B0B0"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Жанры -->
                        <TextBlock Text="Жанры:" 
                                   FontWeight="SemiBold"
                                   Foreground="#B0B0B0"
                                   Margin="0,0,0,5"/>
                        <ItemsControl x:Name="GenresList"
                                      Margin="0,0,0,15">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#2D2D2D"
                                            CornerRadius="15"
                                            Padding="12,5"
                                            Margin="0,0,8,5">
                                        <TextBlock Text="{Binding}" 
                                                   Foreground="White"
                                                   FontSize="12"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Кнопки действий -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <Button x:Name="WatchedButton"
                                    Style="{StaticResource ActionButton}"
                                    Content="✓ Просмотрено"
                                    Click="WatchedButton_Click"
                                    Background="#00B894"
                                    Margin="0,0,10,0"/>

                            <Button x:Name="WatchListButton"
                                    Style="{StaticResource ActionButton}"
                                    Content="📋 Хочу посмотреть"
                                    Click="WatchListButton_Click"
                                    Background="#FDCB6E"
                                    Margin="0,0,10,0"/>

                            <Button x:Name="FavoriteButton"
                                    Style="{StaticResource ActionButton}"
                                    Content="❤️ В избранное"
                                    Click="FavoriteButton_Click"
                                    Background="#E17055"/>
                        </StackPanel>

                        <TextBlock x:Name="WatchedStatusText"
                                   Text=""
                                   FontSize="12"
                                   Foreground="#00B894"
                                   Margin="0,0,0,5"/>
                        <TextBlock x:Name="WatchListStatusText"
                                   Text=""
                                   FontSize="12"
                                   Foreground="#FDCB6E"
                                   Margin="0,0,0,5"/>
                        <TextBlock x:Name="FavoriteStatusText"
                                   Text=""
                                   FontSize="12"
                                   Foreground="#E17055"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Система оценки -->
            <Border Background="{StaticResource CardGradient}"
                    CornerRadius="20"
                    Padding="20"
                    Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Ваша оценка:" 
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10"/>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ItemsControl x:Name="RatingStars" Loaded="RatingStars_Loaded">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="★"
                                            Style="{StaticResource StarButton}"
                                            Tag="{Binding}"
                                            Click="StarButton_Click"
                                            MouseEnter="StarButton_MouseEnter"
                                            MouseLeave="StarButton_MouseLeave"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="SelectedRatingText"
                                   Text="0/10"
                                   FontSize="14"
                                   Foreground="#B0B0B0"
                                   Margin="15,0,0,0"/>
                    </StackPanel>

                    <Button x:Name="SubmitRatingButton"
                            Style="{StaticResource ActionButton}"
                            Content="Подтвердить оценку"
                            Click="SubmitRatingButton_Click"
                            Background="#6C5CE7"
                            Width="150"
                            Margin="0,15,0,0"
                            IsEnabled="False"/>
                </StackPanel>
            </Border>

            <!-- Описание -->
            <Border Background="{StaticResource CardGradient}"
                    CornerRadius="20"
                    Padding="20"
                    Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Описание:" 
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10"/>

                    <TextBox x:Name="MovieDescription" 
                             TextWrapping="Wrap" 
                             FontSize="14"
                             Background="#2D2D2D"
                             Foreground="#B0B0B0"
                             BorderThickness="0"
                             Padding="15"
                             IsReadOnly="True"
                             Text="Загрузка описания..."
                             VerticalScrollBarVisibility="Auto"
                             MinHeight="120"/>
                </StackPanel>
            </Border>

            <!-- Отзывы -->
            <Border Background="{StaticResource CardGradient}"
                    CornerRadius="20"
                    Padding="20"
                    Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="📝 Отзывы" 
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#6C5CE7"
                               Margin="0,0,0,15"/>

                    <!-- Панель для написания отзыва -->
                    <Border Background="#2D2D2D"
                            CornerRadius="15"
                            Padding="15"
                            Margin="0,0,0,15">

                        <StackPanel>
                            <TextBlock x:Name="ReviewLoginPrompt" 
                                       Text="Войдите в систему, чтобы оставить отзыв"
                                       Foreground="#B0B0B0"
                                       Visibility="Collapsed"
                                       HorizontalAlignment="Center"/>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBox x:Name="ReviewTextBox"
                                         Grid.Row="0"
                                         Style="{StaticResource ModernTextBox}"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         Height="100"
                                         MaxLength="1000"
                                         Margin="0,0,0,10"/>

                                <StackPanel Grid.Row="1" 
                                            Orientation="Horizontal" 
                                            HorizontalAlignment="Right">

                                    <TextBlock x:Name="ReviewCharCount"
                                               Text="0/1000"
                                               FontSize="11"
                                               Foreground="#B0B0B0"
                                               VerticalAlignment="Center"
                                               Margin="0,0,15,0"/>

                                    <Button x:Name="DeleteReviewButton"
                                            Style="{StaticResource ActionButton}"
                                            Content="🗑️ Удалить"
                                            Click="DeleteReviewButton_Click"
                                            Background="#D63031"
                                            Margin="0,0,10,0"
                                            Visibility="Collapsed"/>

                                    <Button x:Name="CancelEditReviewButton"
                                            Style="{StaticResource ActionButton}"
                                            Content="✖️ Отмена"
                                            Click="CancelEditReviewButton_Click"
                                            Background="#636E72"
                                            Margin="0,0,10,0"
                                            Visibility="Collapsed"/>

                                    <Button x:Name="SaveReviewButton"
                                            Style="{StaticResource ActionButton}"
                                            Content="📨 Опубликовать"
                                            Click="SaveReviewButton_Click"
                                            Background="#6C5CE7"
                                            IsEnabled="False"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Список отзывов -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="400">
                        <StackPanel x:Name="ReviewsListPanel"/>
                    </ScrollViewer>

                    <TextBlock x:Name="NoReviewsText"
                               Text="Пока нет отзывов. Будьте первым!"
                               Foreground="#B0B0B0"
                               HorizontalAlignment="Center"
                               Margin="20"
                               Visibility="Collapsed"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>