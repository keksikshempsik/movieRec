<Window x:Class="MovieRecV5.ViewModels.FiltersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Фильтры" 
        Height="600" 
        Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1E1E1E">

    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryColor" Color="#6C5CE7"/>
        <SolidColorBrush x:Key="SurfaceColor" Color="#2D2D2D"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#B0B0B0"/>

        <Style x:Key="FilterButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#404040"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="5,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" 
                   Text="🎯 Фильтры" 
                   FontSize="24" 
                   FontWeight="Bold"
                   Foreground="{StaticResource TextPrimary}"
                   Margin="0,0,0,20"/>

        <!-- Содержимое фильтров -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Сортировка -->
                <GroupBox Header="📊 Сортировка" 
                          Foreground="{StaticResource TextPrimary}"
                          BorderBrush="#404040"
                          Margin="0,0,0,15">
                    <StackPanel Margin="10">
                        <ComboBox x:Name="SortByComboBox" 
                                  Height="35"
                                  Background="#2D2D2D"
                                  Foreground="White"
                                  Margin="0,0,0,10">
                            <ComboBoxItem Content="По популярности" Tag="popularity" IsSelected="True"/>
                            <ComboBoxItem Content="По рейтингу" Tag="rating"/>
                            <ComboBoxItem Content="По году" Tag="year"/>
                            <ComboBoxItem Content="По названию" Tag="title"/>
                            <ComboBoxItem Content="По количеству оценок" Tag="votes"/>
                        </ComboBox>

                        <CheckBox x:Name="SortDescendingCheckBox" 
                                  Content="По убыванию"
                                  Foreground="{StaticResource TextPrimary}"
                                  IsChecked="True"
                                  Margin="0,5,0,0"/>
                    </StackPanel>
                </GroupBox>

                <!-- Жанры -->
                <GroupBox Header="🎭 Жанры" 
                          Foreground="{StaticResource TextPrimary}"
                          BorderBrush="#404040"
                          Margin="0,0,0,15">
                    <ScrollViewer MaxHeight="200" 
                                  VerticalScrollBarVisibility="Auto"
                                  Margin="10">
                        <ItemsControl x:Name="GenresItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding}" 
                                              Foreground="{StaticResource TextPrimary}"
                                              Margin="0,3"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </GroupBox>

                <!-- Год выпуска -->
                <GroupBox Header="📅 Год выпуска" 
                          Foreground="{StaticResource TextPrimary}"
                          BorderBrush="#404040"
                          Margin="0,0,0,15">
                    <StackPanel Margin="10">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="От:" 
                                       Foreground="{StaticResource TextSecondary}"
                                       Width="30"
                                       VerticalAlignment="Center"/>
                            <TextBox x:Name="YearFromTextBox" 
                                     Style="{StaticResource FilterTextBox}"
                                     Width="100"/>
                            <TextBlock Text="До:" 
                                       Foreground="{StaticResource TextSecondary}"
                                       Width="30"
                                       Margin="20,0,0,0"
                                       VerticalAlignment="Center"/>
                            <TextBox x:Name="YearToTextBox" 
                                     Style="{StaticResource FilterTextBox}"
                                     Width="100"/>
                        </StackPanel>

                        <ComboBox x:Name="YearPresetsComboBox" 
                                  Height="35"
                                  Background="#2D2D2D"
                                  Foreground="White"
                                  SelectionChanged="YearPresetsComboBox_SelectionChanged">
                            <ComboBoxItem Content="Все годы" Tag="all" IsSelected="True"/>
                            <ComboBoxItem Content="2020-е" Tag="2020s"/>
                            <ComboBoxItem Content="2010-е" Tag="2010s"/>
                            <ComboBoxItem Content="2000-е" Tag="2000s"/>
                            <ComboBoxItem Content="1990-е" Tag="1990s"/>
                            <ComboBoxItem Content="1980-е и раньше" Tag="older"/>
                        </ComboBox>
                    </StackPanel>
                </GroupBox>

                <!-- Рейтинг -->
                <GroupBox Header="⭐ Рейтинг" 
                          Foreground="{StaticResource TextPrimary}"
                          BorderBrush="#404040"
                          Margin="0,0,0,15">
                    <StackPanel Margin="10">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="От:" 
                                       Foreground="{StaticResource TextSecondary}"
                                       Width="30"
                                       VerticalAlignment="Center"/>
                            <TextBox x:Name="RatingFromTextBox" 
                                     Style="{StaticResource FilterTextBox}"
                                     Width="80"/>
                            <TextBlock Text="До:" 
                                       Foreground="{StaticResource TextSecondary}"
                                       Width="30"
                                       Margin="20,0,0,0"
                                       VerticalAlignment="Center"/>
                            <TextBox x:Name="RatingToTextBox" 
                                     Style="{StaticResource FilterTextBox}"
                                     Width="80"/>
                        </StackPanel>

                        <TextBlock Text="Минимум оценок:" 
                                   Foreground="{StaticResource TextSecondary}"
                                   Margin="0,10,0,5"/>
                        <TextBox x:Name="VotesFromTextBox" 
                                 Style="{StaticResource FilterTextBox}"
                                 Width="100"
                                 Text="100"/>
                    </StackPanel>
                </GroupBox>

                <!-- Дополнительные фильтры -->
                <GroupBox Header="🔍 Дополнительно" 
                          Foreground="{StaticResource TextPrimary}"
                          BorderBrush="#404040"
                          Margin="0,0,0,15">
                    <StackPanel Margin="10">
                        <CheckBox x:Name="OnlyWatchedCheckBox" 
                                  Content="Только просмотренные"
                                  Foreground="{StaticResource TextPrimary}"
                                  Margin="0,5"/>

                        <CheckBox x:Name="OnlyWatchListCheckBox" 
                                  Content="Только в списке к просмотру"
                                  Foreground="{StaticResource TextPrimary}"
                                  Margin="0,5"/>

                        <CheckBox x:Name="OnlyFavoritesCheckBox" 
                                  Content="Только избранное"
                                  Foreground="{StaticResource TextPrimary}"
                                  Margin="0,5"/>

                        <CheckBox x:Name="OnlyWithPosterCheckBox" 
                                  Content="Только с постером"
                                  Foreground="{StaticResource TextPrimary}"
                                  IsChecked="True"
                                  Margin="0,5"/>
                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>

        <!-- Кнопки -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button Content="🔄 Сбросить" 
                    Style="{StaticResource FilterButton}"
                    Background="#404040"
                    Width="120"
                    Margin="0,0,10,0"
                    Click="ResetButton_Click"/>

            <Button Content="✅ Применить" 
                    Style="{StaticResource FilterButton}"
                    Width="120"
                    Click="ApplyButton_Click"/>
        </StackPanel>
    </Grid>
</Window>