<Window x:Class="MovieRecV5.ViewModels.WatchedMoviesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Просмотренные фильмы" 
        Height="700" 
        Width="1000"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#0F0F0F"
        Foreground="White"
        FontFamily="Segoe UI">

    <Window.Resources>
        <LinearGradientBrush x:Key="WatchedGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#6C5CE7" Offset="0"/>
            <GradientStop Color="#00B894" Offset="1"/>
        </LinearGradientBrush>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок и кнопка назад -->
        <Border Grid.Row="0" 
                Background="{StaticResource WatchedGradient}"
                Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BackButton" 
                        Content="← Назад" 
                        Style="{StaticResource ActionButton}"
                        Background="Transparent"
                        BorderBrush="White"
                        BorderThickness="1"
                        Width="80"
                        Height="35"
                        Click="BackButton_Click"
                        Margin="0,0,20,0"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="✓" 
                               FontSize="28" 
                               Margin="0,0,10,0"/>
                    <TextBlock Text="Просмотренные фильмы" 
                               FontSize="24" 
                               FontWeight="Bold" 
                               Foreground="White"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Контейнер для фильмов -->
        <ScrollViewer Grid.Row="1" 
                      VerticalScrollBarVisibility="Auto" 
                      HorizontalScrollBarVisibility="Disabled"
                      Background="#0F0F0F">
            <WrapPanel x:Name="MoviesPanel" 
                      HorizontalAlignment="Center"
                      Margin="20"/>
        </ScrollViewer>

        <!-- Текст при отсутствии фильмов -->
        <Grid Grid.Row="1" x:Name="NoMoviesGrid" 
              Background="#0F0F0F"
              Visibility="Collapsed">
            <Border Background="#1E1E1E"
                    CornerRadius="20"
                    Padding="40"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="📺" 
                               FontSize="72" 
                               HorizontalAlignment="Center" 
                               Margin="0,0,0,20"/>
                    <TextBlock Text="Вы еще не посмотрели ни одного фильма" 
                               FontSize="20" 
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20"/>
                    <Button Content="🔍 Найти фильмы"
                            Style="{StaticResource ActionButton}"
                            Background="#00B894"
                            Click="FindMoviesButton_Click"
                            Width="150"
                            Height="40"
                            HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>