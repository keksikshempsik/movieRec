<Window x:Class="MovieRecV5.ViewModels.RecommendationsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Рекомендации фильмов" 
        Height="700" 
        Width="900"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" Background="#2D2D2D" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BackButton" 
                        Content="← Назад" 
                        Click="BackButton_Click"
                        Width="80"
                        Height="30"
                        FontSize="14"
                        Margin="0,0,10,0"/>

                <TextBlock Grid.Column="1" 
                           Text="Персональные рекомендации" 
                           FontSize="16" 
                           FontWeight="Bold" 
                           Foreground="White"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="RefreshButton"
                            Content="🔄 Обновить"
                            Click="RefreshButton_Click"
                            Width="100"
                            Height="30"
                            Margin="5,0,0,0"
                            ToolTip="Обновить рекомендации"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Информация о рекомендациях -->
        <Border Grid.Row="1" Background="#F5F5F5" Padding="10">
            <StackPanel>
                <TextBlock x:Name="RecommendationsInfoText"
                           Text="Загрузка рекомендаций..."
                           TextWrapping="Wrap"
                           FontSize="12"/>

                <!-- Прогресс-бар для загрузки -->
                <ProgressBar x:Name="LoadingProgressBar"
                             Height="10"
                             Margin="0,5,0,0"
                             IsIndeterminate="True"
                             Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <!-- Контейнер для фильмов -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="10">
            <WrapPanel x:Name="MoviesPanel" HorizontalAlignment="Center"/>
        </ScrollViewer>

        <!-- Сообщение при отсутствии рекомендаций -->
        <Grid Grid.Row="2" x:Name="NoRecommendationsGrid" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="🎬" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock Text="Нет рекомендаций" 
                           FontSize="16" 
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,5"/>
                <TextBlock x:Name="NoRecommendationsText"
                           Text="Чтобы получить рекомендации, оцените несколько фильмов" 
                           FontSize="12" 
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Foreground="Gray"
                           Margin="10"/>
                <Button Content="Оценить фильмы"
                        Click="RateMoviesButton_Click"
                        Width="150"
                        Height="30"
                        Margin="0,10,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Статус -->
        <Border Grid.Row="3" Background="#F0F0F0" Padding="10">
            <TextBlock x:Name="StatusText"
                       Text="Готово"
                       FontSize="11"
                       Foreground="Gray"/>
        </Border>
    </Grid>
</Window>