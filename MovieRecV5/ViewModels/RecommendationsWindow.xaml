<Window x:Class="MovieRecV5.ViewModels.RecommendationsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Рекомендации фильмов" 
        Height="750" 
        Width="1100"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#0A0E1A"
        Foreground="White"
        FontFamily="Segoe UI">

    <Window.Resources>
        <LinearGradientBrush x:Key="RecommendationsGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#3B82F6" Offset="0"/>
            <GradientStop Color="#06B6D4" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="ProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#3B82F6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="3">
                            <Grid>
                                <Border x:Name="PART_Track"/>
                                <Border x:Name="PART_Indicator"
                                        Background="{TemplateBinding Foreground}"
                                        CornerRadius="3"
                                        HorizontalAlignment="Left"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" 
                Background="{StaticResource RecommendationsGradient}"
                Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BackButton" 
                        Content="← Назад" 
                        Style="{StaticResource ActionButton}"
                        Background="Transparent"
                        BorderBrush="White"
                        BorderThickness="1"
                        Width="80"
                        Height="35"
                        Click="BackButton_Click"
                        Margin="0,0,20,0"/>

                <TextBlock Grid.Column="1" 
                           Text="Персональные рекомендации" 
                           FontSize="24" 
                           FontWeight="Bold" 
                           Foreground="White"
                           VerticalAlignment="Center"/>

                <Button Grid.Column="2"
                        x:Name="RefreshButton"
                        Content="🔄 Обновить"
                        Style="{StaticResource ActionButton}"
                        Background="#06B6D4"
                        Width="120"
                        Height="35"
                        Click="RefreshButton_Click"
                        ToolTip="Обновить рекомендации"/>
            </Grid>
        </Border>

        <!-- Информация о рекомендациях -->
        <Border Grid.Row="1" 
                Background="#111827" 
                Padding="15"
                Margin="20,15,20,0"
                CornerRadius="10">
            <StackPanel>
                <TextBlock x:Name="RecommendationsInfoText"
                           Text="Анализируем ваши предпочтения..."
                           TextWrapping="Wrap"
                           FontSize="14"
                           Foreground="#94A3B8"/>

                <!-- Прогресс-бар -->
                <ProgressBar x:Name="LoadingProgressBar"
                             Style="{StaticResource ProgressBarStyle}"
                             Margin="0,10,0,0"
                             IsIndeterminate="True"
                             Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <!-- Контейнер для фильмов -->
        <ScrollViewer Grid.Row="2" 
                      VerticalScrollBarVisibility="Auto" 
                      HorizontalScrollBarVisibility="Disabled"
                      Background="#0A0E1A">
            <WrapPanel x:Name="MoviesPanel" 
                      HorizontalAlignment="Center"
                      Margin="20"/>
        </ScrollViewer>

        <!-- Сообщение при отсутствии рекомендаций -->
        <Grid Grid.Row="2" 
              x:Name="NoRecommendationsGrid" 
              Background="#0A0E1A"
              Visibility="Collapsed">
            <Border Background="#111827"
                    CornerRadius="20"
                    Padding="40"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="🎯" 
                               FontSize="72" 
                               HorizontalAlignment="Center" 
                               Margin="0,0,0,20"/>
                    <TextBlock Text="Нет рекомендаций" 
                               FontSize="24" 
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10"/>
                    <TextBlock x:Name="NoRecommendationsText"
                               Text="Чтобы получить рекомендации, оцените несколько фильмов" 
                               FontSize="14" 
                               Foreground="#94A3B8"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Margin="0,0,0,20"
                               MaxWidth="300"/>
                    <Button Content="⭐ Оценить фильмы"
                            Style="{StaticResource ActionButton}"
                            Background="#3B82F6"
                            Click="RateMoviesButton_Click"
                            Width="160"
                            Height="40"
                            HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Статус -->
        <Border Grid.Row="3" 
                Background="#111827" 
                Padding="10">
            <TextBlock x:Name="StatusText"
                       Text="Готово"
                       FontSize="12"
                       Foreground="#94A3B8"
                       VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>