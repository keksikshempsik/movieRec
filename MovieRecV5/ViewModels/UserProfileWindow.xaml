<Window x:Class="MovieRecV5.ViewModels.UserProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Профиль пользователя" Height="760" Width="900"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок и кнопка назад -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="BackButton" 
                    Content="Назад" 
                    Click="BackButton_Click"
                    Width="80"
                    Height="25"/>

            <TextBlock Text="Профиль пользователя" 
                       FontSize="16" 
                       FontWeight="Bold" 
                       VerticalAlignment="Center"
                       Margin="10,0,0,0"/>
        </StackPanel>

        <!-- Основная информация о пользователе -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Аватар -->
            <Border Grid.Column="0"
                    Width="80" 
                    Height="80"
                    Background="LightGray"
                    Margin="0,0,10,0"
                    CornerRadius="40">
                <Image x:Name="UserAvatarImage"
                       Stretch="UniformToFill"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center">
                    <Image.Source>
                        <DrawingImage>
                            <DrawingImage.Drawing>
                                <GeometryDrawing>
                                    <GeometryDrawing.Geometry>
                                        <EllipseGeometry Center="40,40" RadiusX="40" RadiusY="40"/>
                                    </GeometryDrawing.Geometry>
                                    <GeometryDrawing.Brush>
                                        <SolidColorBrush Color="LightGray"/>
                                    </GeometryDrawing.Brush>
                                </GeometryDrawing>
                            </DrawingImage.Drawing>
                        </DrawingImage>
                    </Image.Source>
                </Image>
            </Border>

            <!-- Информация справа -->
            <StackPanel Grid.Column="1">
                <TextBlock x:Name="UserNameText" 
                           FontSize="14" 
                           FontWeight="Bold" 
                           TextWrapping="Wrap"
                           Margin="0,0,0,5"/>

                <TextBlock x:Name="UserEmailText" 
                           FontSize="12" 
                           Margin="0,0,0,5"/>
            </StackPanel>
        </Grid>

        <!-- Статистика -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Основная статистика -->
            <StackPanel Grid.Row="0" Margin="0,0,0,15">
                <TextBlock Text="Статистика просмотров:" 
                           FontWeight="Bold" 
                           FontSize="14"
                           Margin="0,0,0,5"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Vertical" HorizontalAlignment="Center">
                        <TextBlock Text="Просмотрено" FontSize="11" Foreground="Gray" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="WatchedCountText" Text="0" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Center">
                        <TextBlock Text="Хочу посмотреть" FontSize="11" Foreground="Gray" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="WatchListCountText" Text="0" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Vertical" HorizontalAlignment="Center">
                        <TextBlock Text="Оценок" FontSize="11" Foreground="Gray" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="RatingsCountText" Text="0" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Vertical" HorizontalAlignment="Center">
                        <TextBlock Text="Средняя оценка" FontSize="11" Foreground="Gray" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="AvgRatingText" Text="0.0" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4" Orientation="Vertical" HorizontalAlignment="Center">
                        <TextBlock Text="Избранное" FontSize="11" Foreground="Gray" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="FavoritesCountText" Text="0.0" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- Диаграммы -->
            <Grid Grid.Row="1" Margin="0,15,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 1. Жанры -->
                <StackPanel Grid.Row="0" Margin="0,0,0,15">
                    <TextBlock Text="Популярные жанры (по первому жанру фильма)" 
                               FontWeight="SemiBold"
                               Margin="0,0,0,5"/>

                    <Grid x:Name="GenresGrid" 
                          Height="100"
                          Margin="5,0,5,0">
                        <!-- Столбцы будут добавлены динамически -->
                    </Grid>

                    <TextBlock x:Name="GenresSummaryText" 
                               FontSize="11" 
                               Foreground="Gray"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <!-- 2. Годы -->
                <StackPanel Grid.Row="1" Margin="0,0,0,15">
                    <TextBlock Text="Популярные годы выпуска фильмов" 
                               FontWeight="SemiBold"
                               Margin="0,0,0,5"/>

                    <Grid x:Name="YearsGrid" 
                          Height="100"
                          Margin="5,0,5,0">
                        <!-- Столбцы будут добавлены динамически -->
                    </Grid>

                    <TextBlock x:Name="YearsSummaryText" 
                               FontSize="11" 
                               Foreground="Gray"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <!-- 3. Оценки -->
                <StackPanel Grid.Row="2" Margin="0,0,0,15">
                    <TextBlock Text="Распределение оценок (от 1 до 10)" 
                               FontWeight="SemiBold"
                               Margin="0,0,0,5"/>

                    <Grid x:Name="RatingsGrid" 
                          Height="100"
                          Margin="5,0,5,0">
                        <!-- Столбцы будут добавлены динамически -->
                    </Grid>

                    <TextBlock x:Name="RatingsSummaryText" 
                               FontSize="11" 
                               Foreground="Gray"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Действия -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="Редактировать профиль" 
            Click="EditProfileButton_Click"
            Width="150"
            Height="25"
            Margin="0,0,10,0"/>

            <Button Content="Хочу посмотреть" 
            Click="WatchListButton_Click"
            Width="150"
            Height="25"
            Margin="0,0,10,0"/>

            <!-- НОВАЯ КНОПКА -->
            <Button Content="❤️ Избранное" 
            Click="FavoritesButton_Click"
            Width="120"
            Height="25"
            Background="LightPink"
            Margin="0,0,10,0"/>

            <Button Content="Просмотренные фильмы" 
            Click="HistoryButton_Click"
            Width="150"
            Height="25"
            Margin="0,0,10,0"/>

            <Button x:Name="LogoutButton"
            Content="Выйти из аккаунта" 
            Click="LogoutButton_Click"
            Width="120"
            Height="25"/>
        </StackPanel>
    </Grid>
</Window>