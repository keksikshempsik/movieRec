<Window x:Class="MovieRecV5.ViewModels.UserProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Профиль пользователя" 
        Height="800" 
        Width="1000"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0A0E1A"
        Foreground="White"
        FontFamily="Segoe UI">

    <Window.Resources>
        <LinearGradientBrush x:Key="ProfileGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#3B82F6" Offset="0"/>
            <GradientStop Color="#06B6D4" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="StatBoxStyle" TargetType="Border">
            <Setter Property="Background" Value="#111827"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
    </Window.Resources>

    <Border Background="#111827" CornerRadius="20" Margin="15">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок и кнопка назад -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                <Button x:Name="BackButton" 
                        Content="← Назад" 
                        Style="{StaticResource ActionButton}"
                        Background="Transparent"
                        BorderBrush="White"
                        BorderThickness="1"
                        Width="80"
                        Height="35"
                        Click="BackButton_Click"
                        Margin="0,0,20,0"/>

                <TextBlock Text="Профиль пользователя" 
                           FontSize="24" 
                           FontWeight="Bold" 
                           VerticalAlignment="Center"
                           Foreground="White"/>
            </StackPanel>

            <!-- Основная информация о пользователе -->
            <Border Grid.Row="1" 
                    Background="{StaticResource ProfileGradient}"
                    CornerRadius="15"
                    Padding="20"
                    Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Аватар -->
                    <Border Grid.Column="0"
                            Width="100" 
                            Height="100"
                            Background="#1E293B"
                            CornerRadius="50"
                            Margin="0,0,20,0">
                        <Image x:Name="UserAvatarImage"
                               Stretch="UniformToFill"
                               Margin="5"/>
                        <Border.Effect>
                            <DropShadowEffect Color="White" BlurRadius="15" Opacity="0.2"/>
                        </Border.Effect>
                    </Border>

                    <!-- Информация справа -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="UserNameText" 
                                   FontSize="22" 
                                   FontWeight="Bold" 
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,5"/>

                        <TextBlock x:Name="UserEmailText" 
                                   FontSize="14" 
                                   Foreground="#E0E0E0"
                                   Margin="0,0,0,5"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Статистика -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Основная статистика -->
                    <WrapPanel Margin="0,0,0,20">
                        <Border Style="{StaticResource StatBoxStyle}">
                            <StackPanel>
                                <TextBlock Text="Просмотрено" 
                                           FontSize="12" 
                                           Foreground="#94A3B8" 
                                           HorizontalAlignment="Center"/>
                                <TextBlock x:Name="WatchedCountText" 
                                           Text="0" 
                                           FontSize="28" 
                                           FontWeight="Bold" 
                                           Foreground="#06B6D4"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource StatBoxStyle}">
                            <StackPanel>
                                <TextBlock Text="Хочу посмотреть" 
                                           FontSize="12" 
                                           Foreground="#94A3B8" 
                                           HorizontalAlignment="Center"/>
                                <TextBlock x:Name="WatchListCountText" 
                                           Text="0" 
                                           FontSize="28" 
                                           FontWeight="Bold" 
                                           Foreground="#FDCB6E"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource StatBoxStyle}">
                            <StackPanel>
                                <TextBlock Text="Избранное" 
                                           FontSize="12" 
                                           Foreground="#94A3B8" 
                                           HorizontalAlignment="Center"/>
                                <TextBlock x:Name="FavoritesCountText" 
                                           Text="0" 
                                           FontSize="28" 
                                           FontWeight="Bold" 
                                           Foreground="#E17055"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource StatBoxStyle}">
                            <StackPanel>
                                <TextBlock Text="Оценок" 
                                           FontSize="12" 
                                           Foreground="#94A3B8" 
                                           HorizontalAlignment="Center"/>
                                <TextBlock x:Name="RatingsCountText" 
                                           Text="0" 
                                           FontSize="28" 
                                           FontWeight="Bold" 
                                           Foreground="#3B82F6"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource StatBoxStyle}">
                            <StackPanel>
                                <TextBlock Text="Средняя оценка" 
                                           FontSize="12" 
                                           Foreground="#94A3B8" 
                                           HorizontalAlignment="Center"/>
                                <TextBlock x:Name="AvgRatingText" 
                                           Text="0.0" 
                                           FontSize="28" 
                                           FontWeight="Bold" 
                                           Foreground="#FFD700"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>

                    <!-- Диаграммы -->
                    <StackPanel>
                        <!-- 1. Жанры -->
                        <Border Background="#1E293B" CornerRadius="15" Padding="15" Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="Популярные жанры" 
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="#3B82F6"
                                           Margin="0,0,0,10"/>
                                <Grid x:Name="GenresGrid" Height="100"/>
                                <TextBlock x:Name="GenresSummaryText" 
                                           FontSize="12" 
                                           Foreground="#94A3B8"
                                           TextWrapping="Wrap"
                                           Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- 2. Годы -->
                        <Border Background="#1E293B" CornerRadius="15" Padding="15" Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="Популярные годы" 
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="#06B6D4"
                                           Margin="0,0,0,10"/>
                                <Grid x:Name="YearsGrid" Height="100"/>
                                <TextBlock x:Name="YearsSummaryText" 
                                           FontSize="12" 
                                           Foreground="#94A3B8"
                                           TextWrapping="Wrap"
                                           Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- 3. Оценки -->
                        <Border Background="#1E293B" CornerRadius="15" Padding="15" Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="Распределение оценок" 
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="#FFD700"
                                           Margin="0,0,0,10"/>
                                <Grid x:Name="RatingsGrid" Height="100"/>
                                <TextBlock x:Name="RatingsSummaryText" 
                                           FontSize="12" 
                                           Foreground="#94A3B8"
                                           TextWrapping="Wrap"
                                           Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Действия -->
            <WrapPanel Grid.Row="3" 
                       Margin="0,20,0,0"
                       HorizontalAlignment="Center">
                <Button Content="✏️ Редактировать профиль" 
                        Style="{StaticResource ActionButton}"
                        Background="#3B82F6"
                        Click="EditProfileButton_Click"
                        Width="160"
                        Margin="0,0,10,0"/>

                <Button Content="📋 Хочу посмотреть" 
                        Style="{StaticResource ActionButton}"
                        Background="#FDCB6E"
                        Click="WatchListButton_Click"
                        Width="160"
                        Margin="0,0,10,0"/>

                <Button Content="❤️ Избранное" 
                        Style="{StaticResource ActionButton}"
                        Background="#E17055"
                        Click="FavoritesButton_Click"
                        Width="140"
                        Margin="0,0,10,0"/>

                <Button Content="✓ Просмотренные" 
                        Style="{StaticResource ActionButton}"
                        Background="#06B6D4"
                        Click="HistoryButton_Click"
                        Width="160"
                        Margin="0,0,10,0"/>

                <Button x:Name="LogoutButton"
                        Content="🚪 Выйти" 
                        Style="{StaticResource ActionButton}"
                        Background="#D63031"
                        Click="LogoutButton_Click"
                        Width="120"/>
            </WrapPanel>
        </Grid>
    </Border>
</Window>